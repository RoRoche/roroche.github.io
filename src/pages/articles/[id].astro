---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getArticles, href, asset, articleDate } from '../../lib/content';
import { labels } from '../../data/site';
export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
---

<Layout
  title={article.data.title}
  description={article.data.description}
  image={asset(article.data.image)}
  noindex={article.data.draft}
>
  <article class="container article-page">
    <header class="article-header">
      <a class="text-link" href={href('articles/')}>
        ← All articles
      </a>
      <p class="eyebrow">
        {labels[article.data.category]}
        {article.data.draft && ' / Draft preview'}
      </p>
      <h1>{article.data.title}</h1>
      <p class="lead">{article.data.description}</p>
      <div class="article-meta">
        <span>Romain Rochegude</span>
        <time datetime={article.data.date.toISOString()}>
          {articleDate(article.data.date, article.data.draft)}
        </time>
      </div>
      <div class="tags">
        {article.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <img
        class="article-cover"
        src={asset(article.data.image)}
        alt=""
        width="1200"
        height="630"
      />
    </header>
    <div class="article-layout">
      <aside class="toc">
        <p class="eyebrow">On this page</p>
        <nav aria-label="Table of contents">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
      </aside>
      <div class="prose">
        <Content />
        <hr />
        <p>
          <a href={article.data.source}>Read the source on GitHub ↗</a>
        </p>
      </div>
    </div>
  </article>
</Layout>
