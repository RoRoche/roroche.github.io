---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/content';
---

<Layout title="Page not found" noindex>
  <section class="container page-intro">
    <p class="eyebrow">404 / A missing connection</p>
    <h1>
      Nothing here.
      <br />
      Plenty to explore<span class="accent">.</span>
    </h1>
    <p>This page may have moved, or the address may be incorrect.</p>
    <a class="button" href={href()}>
      Back to home →
    </a>
  </section>
</Layout>
