---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/romain-rochegude.jpg';
import { site } from '../data/site';
const journey = [
  [
    '2025 — today',
    'Leading teams. Passing it on.',
    'As an IT technical manager at Accenture, I coach teams, support technical decisions and embed continuous improvement. Teaching software architecture and quality at ISIMA brings these practices into the classroom.',
  ],
  [
    '2022 — today',
    'Exploring what comes next.',
    'Innovation consulting at Accenture has broadened my work into automation, generative AI and the ways emerging tools can improve engineering practice.',
  ],
  [
    '2017 — 2022',
    'From implementation to architecture.',
    'At Accenture, I moved through software development, technical leadership and software architecture: shaping Java systems, delivery pipelines and shared architecture decisions.',
  ],
  [
    '2012 — 2017',
    'Learning through mobile.',
    'At Openium and Modis, I built iOS and Android applications, introduced automated tests and CI, and began mentoring other developers.',
  ],
  [
    '2010 — 2011',
    'The first building blocks.',
    'Java web development and mobile prototyping at Sopra Steria gave me my first professional grounding in building and maintaining software.',
  ],
];
---

<Layout title="About">
  <section class="container page-intro about-intro">
    <div class="about-intro-copy">
      <p class="eyebrow">The person behind the practice</p>
      <h1>
        Hi, I’m Romain<span class="accent">.</span>
      </h1>
      <p>
        A software architect, technical leader and educator based in
        Clermont-Ferrand, France. Curious about code. Invested in people.
      </p>
      <div class="actions">
        <a class="button" href={site.linkedin}>
          Connect on LinkedIn ↗
        </a>
        <a class="text-link" href={site.github}>
          Find me on GitHub ↗
        </a>
      </div>
    </div>
    <figure class="portrait-composition">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Portrait of Romain Rochegude"
          widths={[360, 540, 720]}
          sizes="(max-width: 700px) 82vw, (max-width: 1000px) 36vw, 420px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <svg
        class="portrait-network"
        viewBox="0 0 480 480"
        fill="none"
        aria-hidden="true"
      >
        <path
          class="portrait-orbit"
          d="M240 10 439 125v230L240 470 41 355V125Z"
        />
        <path d="M240 10v29m199 86-25 15m25 215-25-15M240 470v-29M41 355l25-15m-25-215 25 15" />
        <circle cx="240" cy="10" r="4" />
        <circle cx="439" cy="355" r="4" />
        <circle cx="41" cy="355" r="4" />
      </svg>
      <figcaption>
        Architecture <span aria-hidden="true">/</span> Engineering{' '}
        <span aria-hidden="true">/</span> DevSecOps
      </figcaption>
    </figure>
  </section>
  <section class="container about-story section">
    <p class="eyebrow">A thread through the years</p>
    <div>
      <h2>
        My scope has changed.
        <br />
        My curiosity hasn’t.
      </h2>
      <p>
        I started by making software work. Over time, the questions became
        wider: how do we make it easier to change? How do we build confidence in
        it? And how do we help a whole team succeed?
      </p>
      <p>
        Today, my work sits at the intersection of architecture, craftsmanship
        and leadership. I still enjoy small, well-designed objects and a test
        that tells a clear story. I also care about the conditions that let
        people build them: shared context, useful automation and room to learn.
      </p>
      <p>
        Open source, writing and teaching are ways to make that learning useful
        beyond a single project.
      </p>
    </div>
  </section>
  <section class="container section">
    <p class="eyebrow">My journey</p>
    <div class="timeline">
      {journey.map(([date, title, text]) => (
        <article>
          <span class="small-label">{date}</span>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .about-intro-copy > p:not(.eyebrow) {
    max-width: 600px;
    margin-top: 28px;
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .portrait-composition {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    padding: 30px 30px 52px;
    isolation: isolate;
  }
  .portrait-composition::before {
    content: '';
    position: absolute;
    inset: 0 0 22px;
    z-index: -1;
    background: radial-gradient(ellipse, #91bfff18, transparent 70%);
  }
  .portrait-frame {
    aspect-ratio: 1;
    padding: 2px;
    background: linear-gradient(
      145deg,
      var(--accent),
      var(--line) 65%,
      #5e8fc6
    );
    clip-path: polygon(
      50% 0,
      93.3% 25%,
      93.3% 75%,
      50% 100%,
      6.7% 75%,
      6.7% 25%
    );
  }
  .portrait-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    clip-path: polygon(
      50% 0,
      93.3% 25%,
      93.3% 75%,
      50% 100%,
      6.7% 75%,
      6.7% 25%
    );
  }
  .portrait-network {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    stroke: #5e8fc6;
    stroke-width: 1;
    pointer-events: none;
  }
  .portrait-orbit {
    stroke: var(--line);
  }
  .portrait-network circle {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  figcaption {
    margin-top: 36px;
    text-align: center;
    color: var(--muted);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  figcaption span {
    margin-inline: 6px;
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .about-intro-copy > p:not(.eyebrow) {
      font-size: 1rem;
    }
    .portrait-composition {
      width: min(100%, 360px);
      padding-bottom: 20px;
    }
  }
</style>
