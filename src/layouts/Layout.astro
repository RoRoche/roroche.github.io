---
import '@fontsource-variable/roboto';
import '../styles/global.css';
import { site } from '../data/site';
import { href } from '../lib/content';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  image = href('social.png'),
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Software architect & technical leader`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['Articles', 'articles/'],
  ['Open Source', 'open-source/'],
  ['Talks & Teaching', 'talks/'],
  ['Book', 'book/'],
  ['About', 'about/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101413" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="wordmark" href={href()} aria-label="Romain Rochegude, home">
        <span class="monogram">
          r<span>.</span>
        </span>
        <span>
          Romain
          <br />
          Rochegude<span class="accent">.</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([label, path]) => (
          <a
            href={href(path)}
            aria-current={
              Astro.url.pathname.startsWith(href(path)) ? 'page' : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="container site-footer">
      <div>
        <a class="footer-name" href={href()}>
          Romain Rochegude<span class="accent">.</span>
        </a>
        <p>Better software. Stronger teams. Shared knowledge.</p>
      </div>
      <div class="footer-links">
        <a href={site.github}>GitHub ↗</a>
        <a href={site.linkedin}>LinkedIn ↗</a>
        <a href={href('articles/')}>Articles →</a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Romain Rochegude</span>
        <span>Thoughtfully built with Astro.</span>
      </div>
    </footer>
  </body>
</html>
