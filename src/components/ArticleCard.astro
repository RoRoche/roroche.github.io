---
import type { CollectionEntry } from 'astro:content';
import { asset, href, articleDate } from '../lib/content';
import { labels } from '../data/site';
interface Props {
  article: CollectionEntry<'articles'>;
  priority?: boolean;
}
const { article, priority = false } = Astro.props;
---

<article class="article-card">
  <a
    href={href(`articles/${article.id}/`)}
    class="article-image"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={asset(article.data.image)}
      alt=""
      width="1200"
      height="630"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </a>
  <div class="article-meta">
    <span class="eyebrow">{labels[article.data.category]}</span>
    <time datetime={article.data.date.toISOString()}>
      {articleDate(article.data.date, article.data.draft)}
    </time>
    {import.meta.env.PROD &&
      !article.data.draft &&
      process.env.INCLUDE_DRAFTS !== 'true' && (
        <span
          data-visit-count={
            new URL(href(`articles/${article.id}/`), Astro.url).pathname
          }
          hidden
          aria-live="polite"
        ></span>
      )}
    {article.data.draft && <span>Draft preview</span>}
  </div>
  <h3>
    <a href={href(`articles/${article.id}/`)}>
      {article.data.title}
      <span aria-hidden="true"> ↗</span>
    </a>
  </h3>
  <p>{article.data.description}</p>
  <div class="tags">
    {article.data.tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
</article>
